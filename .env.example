# Create a Google Cloud project, enable billing, and enable the Maps JavaScript API,
# Places API (New), and Routes API. Restrict this browser key by website referrer
# and by API before using it outside local development.
GOOGLE_MAPS_BROWSER_API_KEY=

# Optional: unlock the VSSUT location and verified-road-graph editor.
CAMPUS_ADMIN_PASSWORD=

# Optional: create a login administrator account on first startup.
# Set a unique strong password; no default administrator password is provided.
CAMPUS_LOGIN_ADMIN_EMAIL=admin@campusai.com
CAMPUS_LOGIN_ADMIN_PASSWORD=
